# Optional install defaults for Groundskeeper. Copy to .env (chmod 600) and fill in only what you want.
# Every value here can also be set in the panel (Settings), and a value set there wins over this file.
# Leave a line empty to use the default shown in its comment.

# -- Robot (Settings -> Robot) --
# The robot's LAN address (its on-board MQTT broker). Empty: set it in the panel or let it be discovered.
YARBO_HOST=
# The broker's port (default 1883).
YARBO_PORT=
# The robot's serial number, as in its MQTT topics. Empty: read from the robot's heartbeat.
YARBO_SN=

# -- Cameras (Settings -> Cameras) --
# Frigate NVR address, e.g. http://frigate.local:5000
FRIGATE_URL=

# -- Home Assistant (Settings -> Home Assistant) --
# e.g. http://homeassistant.local:8123
HA_URL=
# A long-lived access token from your HA profile. Keep this file private.
HA_TOKEN=

# -- Lawn conditions (Settings -> Lawn conditions) --
# UDP port of a Tempest weather station's broadcast (default 50222; needs host networking).
TEMPEST_PORT=

# -- This panel (Settings -> This panel) --
# The address people use to open the panel, for links in notifications, e.g. http://server.local:8425
PANEL_URL=
# Robot polling while idle, in seconds (default 60).
POLL_IDLE_S=
# Robot polling during a run, in seconds (default 2).
POLL_ACTIVE_S=
# How often the map is re-read from the robot, in seconds (default 21600, six hours).
MAP_REFRESH_S=
# Raw snapshot interval, in seconds (default 60).
RAW_EVERY_S=
# Days raw snapshots are kept (default 90).
RAW_KEEP_DAYS=
# Seconds without movement before a run is considered over (default 300).
RUN_IDLE_END_S=

# -- Container --
# Time zone for the scheduler's clock, e.g. America/New_York
TZ=
# off turns the panel's own sign-in off. Only behind a reverse proxy that signs people in itself: without it,
# anyone who can reach the panel can use it, robot control included.
PANEL_AUTH=
# Behind a reverse proxy: its address, so sign-in throttling sees each visitor (uvicorn's setting).
#FORWARDED_ALLOW_IPS=
# 1 runs the demo: a made-up robot mowing a made-up yard, with a week of synthetic history, in a fresh DATA_DIR.
# It never contacts a robot, the Yarbo cloud, Home Assistant, Frigate or a Tempest (their settings are ignored).
# For trying the panel and for scripts/screenshots.py, not for everyday use. DEMO_SEED=1 is the older name.
DEMO=
# With DEMO=1: how much faster than real time the demo robot mows (default 1).
DEMO_SPEED=
