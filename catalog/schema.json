{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Groundskeeper imagery source",
  "description": "One source in the imagery catalog: catalog/sources/<country>/<id>.json. Generated by `python -m app.imagery schema --write`; see catalog/README.md.",
  "type": "object",
  "required": [
    "id",
    "name",
    "country",
    "region",
    "kind",
    "url",
    "native_m",
    "attribution",
    "license",
    "coverage",
    "verified"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,40}$",
      "description": "Unique, lower case, prefixed with the country code (nl_pdok_hr). The file is named after it."
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "description": "The source's own name, without the country (the panel shows region and country)."
    },
    "provider": {
      "type": "string",
      "description": "Who publishes it."
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 alpha-2; XX for a worldwide service. The folder is its lower case (world for XX)."
    },
    "region": {
      "type": "string",
      "description": "What a user reads: Netherlands, Maryland, New South Wales."
    },
    "homepage": {
      "type": "string",
      "pattern": "^https?://",
      "description": "Where its terms and, for keyed sources, its keys are."
    },
    "kind": {
      "enum": [
        "arcgis_image",
        "arcgis_map",
        "wms",
        "tiles"
      ],
      "description": "The protocol: see the kinds in app/imagery/kinds/."
    },
    "url": {
      "type": "string",
      "pattern": "^https?://",
      "description": "The service address. {key} is replaced by the user's key."
    },
    "native_m": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "description": "Ground metres per pixel at full resolution."
    },
    "vintage": {
      "type": "string",
      "description": "Season and date, as far as known: \"Leaf-off spring flights, 2024\"."
    },
    "attribution": {
      "type": "string",
      "minLength": 3,
      "description": "The credit line shown on the map."
    },
    "license": {
      "$ref": "#/$defs/license"
    },
    "auth": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/auth"
        }
      ]
    },
    "cache_days": {
      "type": "number",
      "minimum": 0,
      "description": "How long a fetched image may be kept; 1 for services whose terms limit caching."
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "verified": {
      "$ref": "#/$defs/verified"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "arcgis_image"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "max_px": {
            "type": "integer",
            "description": "The largest image the server returns per request (maxImageWidth in its ?f=json).",
            "title": "Largest image (px)",
            "default": 4096,
            "minimum": 256,
            "maximum": 16384
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "arcgis_map"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "max_px": {
            "type": "integer",
            "description": "The largest image the server returns per request (maxImageWidth in its ?f=json).",
            "title": "Largest image (px)",
            "default": 4096,
            "minimum": 256,
            "maximum": 16384
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "wms"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "layers": {
            "type": "string",
            "description": "Layer name(s), comma-separated, exactly as GetCapabilities lists them.",
            "title": "Layer"
          },
          "styles": {
            "type": "string",
            "description": "Style name(s); usually empty.",
            "title": "Styles",
            "default": ""
          },
          "version": {
            "type": "string",
            "description": "WMS version.",
            "title": "WMS version",
            "enum": [
              "1.3.0",
              "1.1.1"
            ],
            "default": "1.3.0"
          },
          "crs": {
            "type": "string",
            "description": "Coordinate system to ask in; EPSG:3857 when the service offers it.",
            "title": "Coordinates",
            "enum": [
              "EPSG:3857",
              "EPSG:4326"
            ],
            "default": "EPSG:3857"
          },
          "format": {
            "type": "string",
            "description": "Image format to ask for.",
            "title": "Image format",
            "default": "image/jpeg"
          },
          "max_px": {
            "type": "integer",
            "description": "The largest image the server returns per request (MaxWidth in GetCapabilities).",
            "title": "Largest image (px)",
            "default": 2048,
            "minimum": 256,
            "maximum": 16384
          }
        },
        "required": [
          "layers"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "tiles"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "max_zoom": {
            "type": "integer",
            "description": "The deepest zoom level the service has tiles for.",
            "title": "Deepest zoom",
            "default": 19,
            "minimum": 0,
            "maximum": 24
          },
          "scheme": {
            "type": "string",
            "description": "xyz: row 0 at the top (Google, OpenStreetMap, WMTS); tms: row 0 at the bottom.",
            "title": "Row order",
            "enum": [
              "xyz",
              "tms"
            ],
            "default": "xyz"
          },
          "tile_size": {
            "type": "integer",
            "description": "Pixels per tile side: 256, or 512 for @2x tiles.",
            "title": "Tile size (px)",
            "enum": [
              256,
              512
            ],
            "default": 256
          },
          "url": {
            "pattern": "^(?=.*\\{z\\})(?=.*\\{x\\})(?=.*\\{-?y\\})",
            "description": "a tiles url needs {z}, {x} and {y} (or {-y} for a flipped row)"
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "license": {
      "type": "object",
      "required": [
        "id",
        "name",
        "commercial",
        "credit"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "An SPDX id where one exists (CC-BY-4.0), public-domain, or provider-terms."
        },
        "name": {
          "type": "string",
          "description": "One line a user reads."
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "commercial": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "May a commercial deployment use it? null: not known."
        },
        "credit": {
          "type": "boolean",
          "description": "Must the attribution be shown?"
        }
      }
    },
    "auth": {
      "type": "object",
      "required": [
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "description": "What the user must supply: \"a Mapbox access token\"."
        },
        "signup": {
          "type": "string",
          "pattern": "^https?://",
          "description": "Where to get one."
        },
        "header": {
          "type": "object",
          "required": [
            "name",
            "format"
          ],
          "additionalProperties": false,
          "description": "Send the key in a header instead of the url.",
          "properties": {
            "name": {
              "type": "string"
            },
            "format": {
              "type": "string",
              "pattern": "\\{key\\}"
            }
          }
        }
      }
    },
    "coverage": {
      "description": "Where it has imagery; generous on purpose. The panel never contacts a source whose coverage does not contain the yard.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "World"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "ref"
          ],
          "additionalProperties": false,
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^[a-z0-9_]{2,40}$",
              "description": "An outline file: catalog/coverage/<ref>.geojson."
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "enum": [
                "Polygon",
                "MultiPolygon"
              ]
            },
            "coordinates": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      ]
    },
    "verified": {
      "type": "object",
      "required": [
        "date",
        "place",
        "landmark"
      ],
      "additionalProperties": false,
      "description": "The public landmark the contributor checked the source at (never a home).",
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "place": {
          "type": "string"
        },
        "landmark": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          ]
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
